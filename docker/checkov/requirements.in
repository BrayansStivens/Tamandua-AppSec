# Checkov for the worker image with the engines inside (docker/app/Dockerfile, worker-standalone).
# requirements.txt pins it and every dependency with their hashes. To regenerate it, from the repository root:
#   docker run --rm -v "$PWD/docker/checkov:/work" -w /work python:3.12-slim-bookworm sh -c \
#     "pip install pip-tools==7.5.1 && pip-compile --generate-hashes --allow-unsafe --strip-extras --no-header \
#      --output-file requirements.txt requirements.in"
# The version must match IMAGES["checkov"] in tamandua/modules/scanning/engines.py (tests/test_packaging.py checks it).
checkov==3.3.19
