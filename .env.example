# Copia este fichero a .env y ajusta lo que necesites. Todo es opcional.
# .env está en .gitignore: nunca lo subas al repositorio.

# Tu usuario del host, para que ./data y ./config sean tuyos:  id -u  /  id -g
TAMANDUA_UID=1000
TAMANDUA_GID=1000

# Grupo del socket de Docker. Con `make` se detecta solo; defínelo si arrancas con
# `docker compose` directamente en Linux o WSL con Docker nativo:  stat -Lc %g /var/run/docker.sock
# (no pongas 0: ese grupo ya se añade siempre).
# DOCKER_SOCKET_GID=

# Dónde escucha en el host. 127.0.0.1 = solo esta máquina (recomendado).
TAMANDUA_HOST_BIND=127.0.0.1
TAMANDUA_HOST_PORT=8766

# URL con la que abres el panel. Si cambias el puerto o el dominio, cambia también
# ALLOWED_ORIGINS. Fuera de 127.0.0.1/localhost el servidor exige HTTPS (ver README).
TAMANDUA_PUBLIC_URL=http://127.0.0.1:8766
TAMANDUA_ALLOWED_ORIGINS=http://127.0.0.1:8766,http://localhost:8766

# Clave maestra del almacén de secretos (32 bytes en base64): openssl rand -base64 32
# Si la dejas vacía se genera una en ./config/master.key. Ponerla aquí (o en tu gestor
# de secretos) separa la clave del almacén cifrado. Si la pierdes, hay que volver a
# introducir la GitHub App y las claves de IA.
TAMANDUA_MASTER_KEY=

# Segundo factor: admins (por defecto) · all · none
TAMANDUA_REQUIRE_TOTP=admins

# API key gratuita de NVD: la copia local de CVE se descarga ~8 veces más rápido.
# https://nvd.nist.gov/developers/request-an-api-key
TAMANDUA_NVD_API_KEY=

# Permitir analizar imágenes de registros de tu red interna (IP privada). Bloqueado por defecto (SSRF).
# TAMANDUA_ALLOW_PRIVATE_REGISTRIES=1

# Cada cuántos segundos se consultan los pull requests (mínimo 60).
TAMANDUA_PR_POLL_SECONDS=300

# Solo si de verdad quieres HTTP en claro fuera de esta máquina (red de confianza).
# TAMANDUA_ALLOW_INSECURE_HTTP=1

# Contraseña de PostgreSQL: `make setup` la genera. Déjala vacía aquí.
TAMANDUA_DB_PASSWORD=
